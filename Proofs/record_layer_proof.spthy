lemma R3_Length_concealment:
  all-traces
  "∀ actor1 actor2 session_id msg session_key len %seq %epoch #i.
    (SendMsg( actor1, actor2, session_id, msg, session_key, len, %seq,
              %epoch
     ) @ #i) ⇒
    (¬(∃ #j. K( len ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ actor1 actor2 session_id msg session_key len %seq %epoch #i.
  (SendMsg( actor1, actor2, session_id, msg, session_key, len, %seq,
            %epoch
   ) @ #i)
 ∧
  ∃ #j. (K( len ) @ #j)"
*/
simplify
solve( SendMsg( actor1, actor2, session_id, msg, session_key, len,
                %seq, %epoch
       ) @ #i )
  case ClientApp
  solve( ClientKeys( $C, $S, session_id, session_key,
                     session_key_rec, %seq, %epoch, %rec_seq, %rec_epoch,
                     prev_recordnumber
         ) ▶₀ #i )
    case ClientAppAck
    solve( Start( $C, $S, 'client', ~client_session_id ) @ #j.1 )
      case ClientAppAck
      solve( !KU( ~len ) @ #vk )
        case ClientApp
        solve( !KU( ~session_key ) @ #vk.2 )
          case ClientUpdateKeyRec
          solve( Start( $C.1, $S.1, 'client', session_id ) @ #j.1 )
            case ClientAppAck
            solve( !KU( senc(<$C, $S, inc_data, inc_len, %1, (%1%+%1%+%1%+%1)>,
                             ~session_key)
                   ) @ #vk.2 )
              case ClientUpdateKeyRec
              solve( Start( $C.1, $S.1, 'client', session_id ) @ #j.1 )
                case ClientAppAck
                solve( ClientKeys( $C, $S, ~client_session_id, session_key_send,
                                   session_key_rec, %next_seq, %next_epoch, %rec_seq, %rec_epoch,
                                   prev_recordnumber
                       ) ▶₂ #vr.3 )
                  case ClientRecACK
                  solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    case d_0_fst
                    solve( (#vr.7, 0) ~~> (#vk.2, 0) )
                      case d_0_fst
                      solve( (#vr.10, 0) ~~> (#vk.1, 0) )
                        case d_0_fst
                        solve( (#vr.10, 0) ~~> (#vk.2, 0) )
                          case d_0_fst
                          solve( ClientKeysUpdate( $C, $S, ~client_session_id,
                                                   session_key_send, session_key_rec, %next_seq,
                                                   %next_epoch, %rec_seq, %rec_epoch,
                                                   prev_recordnumber
                                 ) ▶₂ #vr.9 )
                            case ClientApp
                            by contradiction /* cyclic */
                          qed
                        next
                          case d_0_snd
                          by contradiction /* forbidden KD-fact */
                        qed
                      next
                        case d_0_snd
                        by contradiction /* forbidden KD-fact */
                      qed
                    next
                      case d_0_snd
                      by contradiction /* forbidden KD-fact */
                    qed
                  next
                    case d_0_snd
                    by contradiction /* forbidden KD-fact */
                  qed
                qed
              qed
            next
              case Reveal_old_key_case_1
              solve( Start( $A, $S.1, 'client', session_id ) @ #j.1 )
                case ClientAppAck
                solve( ClientKeys( $A, $S, ~client_session_id, session_key_send,
                                   session_key_rec, %next_seq, %next_epoch, %rec_seq, %rec_epoch,
                                   prev_recordnumber
                       ) ▶₂ #vr.3 )
                  case ClientRecACK
                  solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    case d_0_fst
                    solve( (#vr.11, 0) ~~> (#vk.1, 0) )
                      case d_0_fst
                      solve( ClientKeysUpdate( $A, $S, ~client_session_id, t,
                                               session_key_rec, %next_seq, %next_epoch, %rec_seq,
                                               %rec_epoch, prev_recordnumber
                             ) ▶₂ #vr.10 )
                        case ClientApp
                        by contradiction /* cyclic */
                      qed
                    next
                      case d_0_snd
                      by contradiction /* forbidden KD-fact */
                    qed
                  next
                    case d_0_snd
                    by contradiction /* forbidden KD-fact */
                  qed
                qed
              qed
            next
              case Reveal_old_key_case_2
              solve( Start( $A, $C.1, 'server', session_id ) @ #j.1 )
                case ClientAppAck
                solve( ClientKeys( $C, $A, ~client_session_id, session_key_send,
                                   session_key_rec, %next_seq, %next_epoch, %rec_seq, %rec_epoch,
                                   prev_recordnumber
                       ) ▶₂ #vr.3 )
                  case ClientRecACK
                  solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    case d_0_fst
                    solve( (#vr.13, 0) ~~> (#vk.1, 0) )
                      case d_0_fst
                      solve( ServerKeysUpdate( $A, $C, ~server_session_id, t,
                                               session_key_rec.1, %next_seq.1, %next_epoch.1,
                                               %rec_seq.1, %rec_epoch.1, prev_recordnumber.1
                             ) ▶₃ #vr.10 )
                        case ServerApp_case_1
                        by contradiction /* impossible chain */
                      next
                        case ServerApp_case_2
                        solve( ClientKeysUpdate( $C, $A, ~client_session_id,
                                                 session_key_send, session_key_rec, %next_seq,
                                                 %next_epoch, %rec_seq, %rec_epoch,
                                                 prev_recordnumber
                               ) ▶₂ #vr.12 )
                          case ClientApp
                          by contradiction /* forbidden KD-fact */
                        qed
                      qed
                    next
                      case d_0_snd
                      by contradiction /* forbidden KD-fact */
                    qed
                  next
                    case d_0_snd
                    by contradiction /* forbidden KD-fact */
                  qed
                qed
              qed
            next
              case ServerUpdateKeyRec
              solve( Start( $S.1, $C.1, 'server', session_id ) @ #j.1 )
                case ClientAppAck
                solve( ClientKeys( $C, $S, ~client_session_id, session_key_send,
                                   session_key_rec, %next_seq, %next_epoch, %rec_seq, %rec_epoch,
                                   prev_recordnumber
                       ) ▶₂ #vr.3 )
                  case ClientRecACK
                  solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    case d_0_fst
                    solve( (#vr.15, 0) ~~> (#vk.1, 0) )
                      case d_0_fst
                      solve( ServerKeys( $S, $C, ~server_session_id, session_key_send.1,
                                         session_key_rec.1, %next_seq.1, %next_epoch.1, %rec_seq.1,
                                         %rec_epoch.1, prev_recordnumber.1
                             ) ▶₂ #vr.8 )
                        case ClientAppAck
                        by contradiction /* forbidden KD-fact */
                      next
                        case ServerRecACK
                        solve( (#vr.12, 0) ~~> (#vk.2, 0) )
                          case d_0_fst
                          solve( (#vr.19, 0) ~~> (#vk.2, 0) )
                            case d_0_fst
                            solve( ClientKeysUpdate( $C, $S, ~client_session_id,
                                                     session_key_send, session_key_rec, %next_seq,
                                                     %next_epoch, %rec_seq, %rec_epoch,
                                                     prev_recordnumber
                                   ) ▶₂ #vr.14 )
                              case ClientApp
                              by contradiction /* forbidden KD-fact */
                            qed
                          next
                            case d_0_snd
                            by contradiction /* forbidden KD-fact */
                          qed
                        next
                          case d_0_snd
                          by contradiction /* forbidden KD-fact */
                        qed
                      qed
                    next
                      case d_0_snd
                      by contradiction /* forbidden KD-fact */
                    qed
